APP_NAME="AI Gateway Service"
APP_ENV="production"
PORT=8000

# Database & Redis (Docker Compose network)
DATABASE_URL="postgresql+asyncpg://gateway_admin:gateway_secret_123@postgres:5432/ai_gateway_db"
REDIS_URL="redis://redis:6379/0"

# LLM Providers (Điền API Key của bạn vào đây)
OPENAI_API_KEY="sk-your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# Master API Key mặc định dùng để test nhanh nội bộ
DEFAULT_GATEWAY_API_KEY="gw-test-secret-key-12345"
